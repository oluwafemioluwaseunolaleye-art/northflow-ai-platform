{
  "name": "northflow-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NorthFlow AI Platform - the client dashboard and automation web application for NorthFlow AI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0",
    "lucide-react": "^0.417.0",
    "zod": "^3.23.8",
    "framer-motion": "^11.3.19",
    "@supabase/supabase-js": "^2.45.0",
    "@supabase/ssr": "^0.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.7",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "prettier": "^3.3.3",
    "@opennextjs/cloudflare": "1.14.0",
    "wrangler": "^4.49.1"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
