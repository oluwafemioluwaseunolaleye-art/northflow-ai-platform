# ─────────────────────────────────────────────────────────────
# NorthFlow AI Platform — Environment Variables (example)
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env or .env.local — they are already git-ignored.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME="NorthFlow AI Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (database + auth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI provider (for lead qualification / automation features). Without this,
# lead qualification falls back to transparent rule-based logic instead of
# calling the Anthropic API — see lib/ai/qualification.ts.
ANTHROPIC_API_KEY=""

# Budget qualification thresholds (USD) — configurable rather than
# hardcoded. See lib/ai/qualification.ts.
QUALIFICATION_MIN_BUDGET_QUALIFIED="5000"
QUALIFICATION_MIN_BUDGET_REVIEW="1500"

# Email provider (for email workflow automation)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="hello@northflow.ai"

# Primary CTA — "Book a Free AI Audit" (Tally intake form)
NEXT_PUBLIC_TALLY_URL="https://tally.so/r/jaX7Za"

# CRM / lead source integrations
CRM_API_KEY=""

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=""
