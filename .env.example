# ─────────────────────────────────────────────────────────────
# NorthFlow AI Platform — Environment Variables (example)
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env or .env.local — they are already git-ignored.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME="NorthFlow AI Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (to be finalized — e.g. Postgres via Supabase/Neon/Prisma)
DATABASE_URL=""

# Authentication (to be finalized — e.g. NextAuth / Clerk / Supabase Auth)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# AI provider (for lead qualification / automation features)
ANTHROPIC_API_KEY=""

# Email provider (for email workflow automation)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="hello@northflow.ai"

# Appointments / scheduling integration
CALENDAR_PROVIDER_API_KEY=""

# CRM / lead source integrations
CRM_API_KEY=""

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=""
