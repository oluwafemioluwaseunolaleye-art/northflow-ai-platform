{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northflow-ai-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Set these as real secrets via `wrangler secret put <NAME>` (or the
  // Workers dashboard) — do not put real values in this file.
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "NorthFlow AI Platform"
  }
}
